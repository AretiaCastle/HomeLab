# General
PROJECT='project'
CRON_FILEPATH='/etc/crontab'
DEPLOYMENTS_BASE_PATH="/home/$USER/devops/deployments"
DEPLOYMENTS_DOCKER_VOLUMES="$DEPLOYMENTS_BASE_PATH/volumes"
DEPLOYMENTS_BACKUPS_PATH="$DEPLOYMENTS_BASE_PATH/backups"

# Backups
BACKUP_RETENTION=7
BACKUP_SCHEDULE='30 3 * * *'

# Remote backups (rsync over ssh). Leave BACKUP_REMOTE_HOST empty to disable.
BACKUP_REMOTE_USER='user'
BACKUP_REMOTE_HOST='nas.home'
BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_PATH='/mnt/main/services/backups'
BACKUP_REMOTE_SSH_KEY="/home/$USER/.ssh/homelab_backup"
BACKUP_REMOTE_RETENTION=30
