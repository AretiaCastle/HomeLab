# Pi-hole container environment.
# Every pihole.toml setting can be set with FTLCONF_<section>_<key>.
# More info at https://docs.pi-hole.net/docker/configuration/

# Change this value to your preferred time zone.
TZ=Europe/Madrid

# Password for the web interface and the API.
# If it is empty a random one is generated and shown in the container logs.
FTLCONF_webserver_api_password=change-me

# Required when running in a bridge network: queries arrive from the docker
# gateway, not from the local subnet.
FTLCONF_dns_listeningMode=ALL

# Upstream DNS servers separated by ';'
FTLCONF_dns_upstreams=1.1.1.1;1.0.0.1
