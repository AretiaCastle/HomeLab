# Duck DNS container environment.
# More info at https://docs.linuxserver.io/images/docker-duckdns/

# Change this value to your preferred time zone.
TZ=Europe/Madrid

# Subdomains to update, comma separated and without ".duckdns.org"
# (e.g. "home" for home.duckdns.org).
SUBDOMAINS=your-subdomain

# Token from https://www.duckdns.org/
TOKEN=your-token
